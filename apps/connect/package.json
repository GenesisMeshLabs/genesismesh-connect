{
  "name": "genesismesh-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/icons.mjs && node scripts/prepare-authority.mjs",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "icons": "node scripts/icons.mjs",
    "ios:init": "node scripts/ios-init.mjs",
    "android:init": "node scripts/android-init.mjs",
    "android:owner:init": "node scripts/android-owner-qualification.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/qrcode": "1.5.6",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
